+void sortHeapify<T>(List<T> entries, int Function(T, T) compare) {
+  for (var i = entries.length ~/ 2 - 1; i >= 0; i--) {
+    _sortHeapDown(entries, i, compare);
+  }
+}
+T sortHeapRemoveWorst<T>(List<T> entries, int Function(T, T) compare) {
+  final result = entries.first;
+  final last = entries.removeLast();
+  if (entries.isNotEmpty) {
+    entries[0] = last;
+    _sortHeapDown(entries, 0, compare);
+  }
+  return result;
+}
+void sortHeapAdd<T>(List<T> entries, T entry, int Function(T, T) compare) {
+  entries.add(entry);
+  var slot = entries.length - 1;
+  while (slot > 0) {
+    final parent = (slot - 1) ~/ 2;
+    if (compare(entries[parent], entry) >= 0) break;
+    entries[slot] = entries[parent];
+    slot = parent;
+  }
+  entries[slot] = entry;
+}
+void _sortHeapDown<T>(List<T> entries, int slot, int Function(T, T) compare) {
+  final entry = entries[slot];
+  while (slot * 2 + 1 < entries.length) {
+    var child = slot * 2 + 1;
+    if (child + 1 < entries.length && compare(entries[child+1], entries[child]) > 0) child++;
+    if (compare(entry, entries[child]) >= 0) break;
+    entries[slot] = entries[child];
+    slot = child;
+  }
+  entries[slot] = entry;
+}
