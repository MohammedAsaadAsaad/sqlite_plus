+  final _expressions = <(int, int, int, bool, bool), (Expr, int, int)>{};
+  SelectStatement? _select;
+
+  SelectStatement selectSyntax() {
+    final cached = _select;
+    if (cached != null) return cached;
+    selectParses++;
+    return _select = SqlParser.prepared(this).select();
+  }
